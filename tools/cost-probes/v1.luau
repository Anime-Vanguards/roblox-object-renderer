P.preload()
P.look(Vector3.new(0, 50, 70), Vector3.zero)
P.base()
local function onBlocks(n, fn) P.blocks(n, 8, {}) for i, p in P.folder:GetChildren() do fn(p, i) end end
P.case("V 10 SurfaceGui empty", function() onBlocks(10, function(p) Instance.new("SurfaceGui").Parent = p end) end)
P.case("V 10 SurfaceGui + Frame", function() onBlocks(10, function(p) local g = Instance.new("SurfaceGui") g.Parent = p local f = Instance.new("Frame") f.Size = UDim2.fromScale(1, 1) f.Parent = g end) end)
P.case("V 10 SurfaceGui + TextLabel", function() onBlocks(10, function(p) local g = Instance.new("SurfaceGui") g.Parent = p local f = Instance.new("TextLabel") f.Size = UDim2.fromScale(1, 1) f.Text = "Hi" f.Parent = g end) end)
P.case("V 10 SurfaceGui 3 Frames each", function() onBlocks(10, function(p) local g = Instance.new("SurfaceGui") g.Parent = p for k = 1, 3 do local f = Instance.new("Frame") f.Size = UDim2.fromScale(0.3, 0.3) f.Position = UDim2.fromScale(k * 0.3 - 0.3, 0) f.Parent = g end end) end)
P.case("V 10 BillboardGui + Frame", function() onBlocks(10, function(p) local g = Instance.new("BillboardGui") g.Size = UDim2.fromOffset(100, 50) g.Parent = p local f = Instance.new("Frame") f.Size = UDim2.fromScale(1, 1) f.Parent = g end) end)
P.case("V 10 BillboardGui + ImageLabel", function() onBlocks(10, function(p) local g = Instance.new("BillboardGui") g.Size = UDim2.fromOffset(100, 50) g.Parent = p local f = Instance.new("ImageLabel") f.Image = "rbxasset://textures/face.png" f.Size = UDim2.fromScale(1, 1) f.Parent = g end) end)
P.case("V 10 Highlight (each part)", function() onBlocks(10, function(p) Instance.new("Highlight").Parent = p end) end)
P.case("V 1 Highlight on folder of 10", function() onBlocks(10, function() end) Instance.new("Highlight").Parent = P.folder end)
P.case("V 10 PointLight", function() onBlocks(10, function(p) local l = Instance.new("PointLight") l.Range = 12 l.Parent = p end) end)
P.case("V 10 PointLight shadows", function() onBlocks(10, function(p) local l = Instance.new("PointLight") l.Range = 12 l.Shadows = true l.Parent = p end) end)
P.case("V 10 SpotLight", function() onBlocks(10, function(p) local l = Instance.new("SpotLight") l.Range = 12 l.Parent = p end) end)
P.case("V 10 Fire", function() onBlocks(10, function(p) Instance.new("Fire").Parent = p end) end, { frames = 40 })
P.case("V 10 Smoke", function() onBlocks(10, function(p) Instance.new("Smoke").Parent = p end) end, { frames = 40 })
P.case("V 10 Sparkles", function() onBlocks(10, function(p) Instance.new("Sparkles").Parent = p end) end, { frames = 40 })
P.case("V 10 SelectionBox", function() onBlocks(10, function(p) local s = Instance.new("SelectionBox") s.Adornee = p s.Parent = p end) end)
P.case("V 10 BoxHandleAdornment", function() onBlocks(10, function(p) local s = Instance.new("BoxHandleAdornment") s.Adornee = p s.Size = p.Size s.Parent = p end) end)
P.case("V 10 SphereHandleAdornment", function() onBlocks(10, function(p) local s = Instance.new("SphereHandleAdornment") s.Adornee = p s.Parent = p end) end)
P.case("V 10 blocks only", function() onBlocks(10, function() end) end)
