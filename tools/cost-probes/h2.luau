P.preload()
P.look(Vector3.new(0, 10, 25), Vector3.new(0, 3, 0))
P.base()
local Players = game:GetService("Players")
local r15 = Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
local hum = r15:FindFirstChildOfClass("Humanoid")
table.insert(P.out, string.format("humanoid display %s namedist %s name %q displayname %q", tostring(hum.DisplayDistanceType), tostring(hum.NameDisplayDistance), r15.Name, hum.DisplayName))
P.case("H2 1 R15 live", function(f) local c = r15:Clone() c:PivotTo(CFrame.new(0, 3, 0)) c.Parent = f end, { frames = 40 })
P.case("H2 1 R15 live, measured late", function(f) local c = r15:Clone() c:PivotTo(CFrame.new(0, 3, 0)) c.Parent = f task.wait(3) end, { frames = 40 })
local ser = game:GetService("SerializationService")
local buf = ser:SerializeInstancesAsync({ r15 })
P.case("H2 1 R15 deserialized", function(f) for _, i in ser:DeserializeInstancesAsync(buf) do i:PivotTo(CFrame.new(0, 3, 0)) i.Parent = f end end, { frames = 40 })
P.case("H2 Humanoid + 10 blocks", function(f) local m = Instance.new("Model") m.Parent = f Instance.new("Humanoid").Parent = m P.blocks(10, 6, {}, m) end, { frames = 30 })
