P.preload()
P.look(Vector3.new(0, 160, 160), Vector3.zero)
P.base()
local MATS = { Enum.Material.Plastic, Enum.Material.SmoothPlastic, Enum.Material.Wood, Enum.Material.Slate, Enum.Material.Concrete, Enum.Material.Metal, Enum.Material.Brick, Enum.Material.Grass, Enum.Material.Marble, Enum.Material.Fabric }
P.case("A 100 blocks same", function() P.blocks(100, 6, {}) end)
P.case("A 100 blocks rand color", function() P.blocks(100, 6, { Color = function(i) return Color3.fromHSV((i * 0.137) % 1, 0.7, 0.9) end }) end)
P.case("A 100 blocks rand size", function() P.blocks(100, 6, { Size = function(i) return Vector3.new(1 + i % 5, 1 + i % 3, 2 + i % 4) end }) end)
P.case("A 100 blocks 10 materials", function() P.blocks(100, 6, { Material = function(i) return MATS[i % 10 + 1] end }) end)
P.case("A 100 blocks 2 materials", function() P.blocks(100, 6, { Material = function(i) return MATS[i % 2 + 1] end }) end)
P.case("A 100 shapes 5 kinds", function()
	P.blocks(20, 6, { Shape = Enum.PartType.Block })
	P.blocks(20, 7, { Shape = Enum.PartType.Ball })
	P.blocks(20, 8, { Shape = Enum.PartType.Cylinder })
	P.grid(20, 9, function(i, pos) P.part({ ClassName = "WedgePart", Position = pos, Size = Vector3.new(4, 4, 4) }) end)
	P.grid(20, 10, function(i, pos) P.part({ ClassName = "CornerWedgePart", Position = pos, Size = Vector3.new(4, 4, 4) }) end)
end)
P.case("A 20 balls", function() P.blocks(20, 7, { Shape = Enum.PartType.Ball }) end)
P.case("A 20 cylinders", function() P.blocks(20, 7, { Shape = Enum.PartType.Cylinder }) end)
P.case("A 20 wedges", function() P.grid(20, 9, function(i, pos) P.part({ ClassName = "WedgePart", Position = pos, Size = Vector3.new(4, 4, 4) }) end) end)
P.case("A 100 blocks reflectance .3", function() P.blocks(100, 6, { Reflectance = 0.3 }) end)
P.case("A 100 blocks transparency .5", function() P.blocks(100, 6, { Transparency = 0.5 }) end)
P.case("A 10 blocks transparency .5", function() P.blocks(10, 6, { Transparency = 0.5 }) end)
P.case("A 100 blocks transp .01", function() P.blocks(100, 6, { Transparency = 0.01 }) end)
P.case("A 100 neon", function() P.blocks(100, 6, { Material = Enum.Material.Neon }) end)
P.case("A 1 neon", function() P.blocks(1, 6, { Material = Enum.Material.Neon }) end)
P.case("A 10 glass", function() P.blocks(10, 6, { Material = Enum.Material.Glass }) end)
P.case("A 10 glass tr.5", function() P.blocks(10, 6, { Material = Enum.Material.Glass, Transparency = 0.5 }) end)
P.case("A 10 forcefield", function() P.blocks(10, 6, { Material = Enum.Material.ForceField }) end)
