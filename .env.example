# Copy to .env (ignored by Git). Used only for authenticated asset downloads: the cookie only ever goes to
# assetdelivery.roblox.com, the Open Cloud API key (scope legacy-asset:manage) only to apis.roblox.com's
# asset delivery route, and the key is tried first. Either may be left empty.
ROBLOX_ASSET_DELIVERY_API_KEY=
ROBLOX_ASSET_DELIVERY_COOKIE=
