/vendor/x264/x86_64-pc-windows-msvc/

# Account cookie for authenticated asset downloads (never commit)
.env
.env.*
!.env.example

# Agent worktrees and local tool state
/.claude/
/node_modules/
*.log
*.tmp
__pycache__/
/target-*
