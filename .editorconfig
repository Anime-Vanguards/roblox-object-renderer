root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = tab
trim_trailing_whitespace = true

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.json]
indent_style = tab

# x264's style, as ror's entry points into it and their build script follow it
[vendor/x264/*.{c,py}]
indent_style = space
indent_size = 4
